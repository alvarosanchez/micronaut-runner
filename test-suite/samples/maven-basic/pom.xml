<?xml version="1.0" encoding="UTF-8"?>
<!--
  A standalone Maven project, not part of the micronaut-runner Gradle build.

  The end-to-end suite (test-suite/src/test/java/io/micronaut/runner/suite) drives it with
  org.apache.maven.shared.invoker, resolving `mvn` from the PATH - there is no Maven wrapper here on
  purpose, so that nothing has to be downloaded to check this sample in - and passing:

      -Drunner.repo=<file: URI of the aggregated -DUMMY repository>
      -Drunner.version=<the -DUMMY version of the plugin under test>
      -Dmicronaut.platform.version / -Dmicronaut.core.version

  The values below are only defaults, so that `mvn -f pom.xml package -Drunner.repo=... -Drunner.version=...`
  also works by hand. A plain `mvn package` with no properties cannot work: there is nowhere to get the
  plugin from.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>maven-basic</artifactId>
    <version>0.1</version>
    <packaging>jar</packaging>
    <name>maven-basic</name>
    <description>The smallest Micronaut application that proves the Maven plugin packages a runnable jar</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- The mojo's mainClass parameter defaults to this, exactly as it does under the Micronaut parent POM. -->
        <exec.mainClass>com.example.Application</exec.mainClass>
        <!-- No tests here; the assertions live in the end-to-end suite that drives this build. -->
        <maven.test.skip>true</maven.test.skip>

        <!-- Overridden by the end-to-end suite. -->
        <runner.repo>file:///nonexistent-runner-test-repo</runner.repo>
        <runner.version>1.0.0-DUMMY</runner.version>
        <micronaut.platform.version>5.1.5</micronaut.platform.version>
        <micronaut.core.version>5.2.2</micronaut.core.version>

        <!-- Pinned so the packaged archive is byte-for-byte reproducible and the build never floats. -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
        <fixture.main.version>v1</fixture.main.version>
        <fixture.package.version>package-v1</fixture.package.version>
        <project.build.outputTimestamp>2024-01-01T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <repositories>
        <repository>
            <id>runner-test-repo</id>
            <url>${runner.repo}</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>runner-test-repo</id>
            <url>${runner.repo}</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.micronaut.platform</groupId>
                <artifactId>micronaut-platform</artifactId>
                <version>${micronaut.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-inject</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.micronaut</groupId>
                            <artifactId>micronaut-inject-java</artifactId>
                            <version>${micronaut.core.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <!-- The lifecycle regression deliberately packages twice without clean. -->
                    <forceCreation>true</forceCreation>
                    <archive>
                        <manifestEntries>
                            <Implementation-Version>${fixture.main.version}</Implementation-Version>
                        </manifestEntries>
                        <manifestSections>
                            <manifestSection>
                                <name>com/example/</name>
                                <manifestEntries>
                                    <Implementation-Version>${fixture.package.version}</Implementation-Version>
                                </manifestEntries>
                            </manifestSection>
                        </manifestSections>
                    </archive>
                </configuration>
            </plugin>

            <!--
              The goal under test. With no classifier it replaces the main artifact, so `package` leaves
              target/maven-basic-0.1.jar (the runner jar) beside target/original-maven-basic-0.1.jar (what
              maven-jar-plugin produced). The end-to-end suite asserts exactly that, and then runs the
              runner jar.
            -->
            <plugin>
                <groupId>io.micronaut.runner</groupId>
                <artifactId>micronaut-runner-maven-plugin</artifactId>
                <version>${runner.version}</version>
                <configuration>
                    <addExports>
                        <addExport>java.base/sun.nio.ch</addExport>
                        <addExport>java.base/jdk.internal.misc</addExport>
                    </addExports>
                    <addOpens>
                        <addOpen>java.base/java.lang</addOpen>
                        <addOpen>java.base/java.util</addOpen>
                    </addOpens>
                </configuration>
                <executions>
                    <execution>
                        <id>package-runner-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>package</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
