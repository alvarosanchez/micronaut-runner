<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- Quiet: the end-to-end suite matches on one line of standard output. -->
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
