<configuration>
    <!-- logback-classic is on this test class path for LogbackPrecompilerTest. This keeps the test JVM's own
         logging quiet, and it is what Logback's default lookup finds when a test hands over to Joran. -->
    <appender name="RUNNER-BUILD-TESTS" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5level %logger - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="RUNNER-BUILD-TESTS"/>
    </root>
</configuration>
