dist/
.DS_Store
target/
.gradle/
.idea/
build/
!build-logic/src/main/java/io/micronaut/build
!build-logic/src/main/kotlin/io/micronaut/build

# The packaging library's Java package is literally named "build", and the unanchored "build/" rule above
# matches a directory of that name at ANY depth, so it silently excluded the whole
# io.micronaut.runner.build package from every commit. Re-include the directory itself: git never descends
# into an excluded directory, so negating the files inside it would not be enough.
!**/src/main/java/io/micronaut/runner/build/
!**/src/test/java/io/micronaut/runner/build/
!**/src/logbackFrontend/java/io/micronaut/runner/build/
classes/
out/
*.db
*.log
*.iml
.classpath
.factorypath
bin/
.settings/
.project
*/test/
*/META-INF/
*.ipr
*.iws
.kotlintest
*/.kotlintest/

# ignore resources, are downloaded via a gradle task from micronaut_docs
src/main/docs/resources/css/highlight/*.css
src/main/docs/resources/css/highlight/*.png
src/main/docs/resources/css/highlight/*.jpg
src/main/docs/resources/css/*.css
src/main/docs/resources/js/*.js
src/main/docs/resources/style/*.html
src/main/docs/resources/img/micronaut-logo-white.svg

# Ignore files generated by test-resources
**/.micronaut/test-resources/

# Ignore gradle.properties generated by micronaut-build
/buildSrc/gradle.properties

# OpenCode files
.sisyphus/

# Sample applications under test-suite are standalone builds
test-suite/samples/**/build/
test-suite/samples/**/.gradle/
test-suite/samples/**/target/

# CDS archives and AOT caches produced by benchmarks and manual runs
*.jsa
*.aot
